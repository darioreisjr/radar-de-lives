# Copie para .env.local e preencha. NUNCA commite .env.local.

# Chave da YouTube Data API v3 (Google Cloud Console > APIs e serviços > Credenciais).
# Somente servidor: NUNCA use o prefixo NEXT_PUBLIC_ nesta variável.
# Recomendado: restringir a chave à "YouTube Data API v3" no Console.
YOUTUBE_API_KEY=

# Cache dos resultados (segundos). Decisão do projeto: 900 (PRD sugeria 120).
# Motivo: search.list tem 100 chamadas/dia por padrão; 900 s ≈ 96 buscas/dia
# com tráfego contínuo, dentro do orçamento abaixo.
LIVE_CACHE_TTL_SECONDS=900
# Por quanto tempo, após o TTL, servir dados antigos (marcados) se o YouTube falhar.
LIVE_STALE_TTL_SECONDS=600
# Intervalo mínimo entre buscas no YouTube (segundos).
LIVE_RATE_LIMIT_SECONDS=30
# Máximo de chamadas search.list por dia neste processo (quota padrão: 100/dia).
YOUTUBE_SEARCH_DAILY_BUDGET=90
# Máximo de revalidações de vídeo (videos.list, 1 unidade cada) por dia, ao abrir o player.
# Sai das 10.000 unidades/dia compartilhadas pelos demais métodos.
YOUTUBE_DETAILS_DAILY_BUDGET=2000

# Região (ISO 3166-1 alfa-2) e idioma preferido de relevância (ISO 639-1).
YOUTUBE_DEFAULT_REGION=BR
YOUTUBE_DEFAULT_LANGUAGE=pt

# URL pública do site (metadados/Open Graph). Em produção, sem esta variável,
# usa siteConfig.url (https://radardelives.darioreis.dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Futuro (não usado nesta versão): cache compartilhado para produção com várias instâncias.
# REDIS_URL=
