# Copie para .env.local e preencha. NUNCA commite .env.local.

# Chave da YouTube Data API v3 (Google Cloud Console > APIs e serviços > Credenciais).
# Somente servidor: NUNCA use o prefixo NEXT_PUBLIC_ nesta variável.
# Recomendado: restringir a chave à "YouTube Data API v3" no Console.
YOUTUBE_API_KEY=

# Cache dos resultados (segundos). Decisão do projeto: 900 (PRD sugeria 120).
# Motivo: search.list tem 100 chamadas/dia por padrão; 900 s ≈ 96 buscas/dia
# com tráfego contínuo, dentro do orçamento abaixo.
LIVE_CACHE_TTL_SECONDS=900
# Por quanto tempo, após o TTL, servir dados antigos (marcados) se o YouTube falhar.
LIVE_STALE_TTL_SECONDS=600
# Intervalo mínimo entre buscas no YouTube (segundos).
LIVE_RATE_LIMIT_SECONDS=30
# Máximo de chamadas search.list por dia neste processo (quota padrão: 100/dia).
YOUTUBE_SEARCH_DAILY_BUDGET=90
# Máximo de revalidações de vídeo (videos.list, 1 unidade cada) por dia, ao abrir o player.
# Sai das 10.000 unidades/dia compartilhadas pelos demais métodos.
YOUTUBE_DETAILS_DAILY_BUDGET=2000

# Região (ISO 3166-1 alfa-2) e idioma preferido de relevância (ISO 639-1).
YOUTUBE_DEFAULT_REGION=BR
YOUTUBE_DEFAULT_LANGUAGE=pt

# URL pública do site (metadados/Open Graph). Em produção, sem esta variável,
# usa siteConfig.url (https://radardelives.darioreis.dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Estado compartilhado em produção (spec 005): cache, orçamento de quota, trava e rate limit.
# Na Vercel, a integração Upstash (Marketplace) cria estas variáveis automaticamente.
# Também aceita os nomes antigos do Vercel KV: KV_REST_API_URL / KV_REST_API_TOKEN.
# Sem elas, tudo fica em memória (ok para desenvolvimento local ou instância única).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: chave do HMAC que pseudonimiza o IP no rate limit.
# Sem ela, usa o token do Upstash. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SECRET=

# Plataformas de lives ativas (spec 023), separadas por vírgula, na ordem de intercalação.
# Valores: youtube, twitch, kick. Ausente ou vazio = youtube (comportamento de sempre).
# Uma plataforma sem credenciais (ou ainda não implementada) fica de fora sem quebrar o site.
# Na Vercel, mudar esta variável só vale depois de um redeploy. Rollback = tirar a plataforma da lista.
LIVES_PROVIDERS=youtube

# Twitch (spec 027). Crie um app em https://dev.twitch.tv/console (exige 2FA).
# Somente servidor: NUNCA use o prefixo NEXT_PUBLIC_. Sem as duas, a Twitch fica de fora.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Categoria "Grand Theft Auto VI" na Twitch (consultada em 2026-11-25). Só mude se a Twitch trocar o id.
TWITCH_GAME_ID=1867279146
# Páginas de 100 lives buscadas na Twitch, das de maior público (spec 035). Padrão 1, de 1 a 3.
# Valores fora da faixa são cortados (0 vira 1; 4 vira 3). Mudar exige redeploy.
TWITCH_MAX_PAGES=1
